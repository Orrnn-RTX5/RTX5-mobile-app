      "  recordKind?: 'closed-position' | 'order' | 'deal';\n" +
      '  profit?: number | null;\n' +
      '  /** Optional note shown beneath the price row (e.g. deal comment from EA or manual entry) */\n' +
      '  note?: string;\n' +
      '  /** Structured fields used by the closed-position card layout (Positions tab). */\n' +
      '  symbolRaw?: string;\n' +
      '  sideRaw?: string;\n' +
      '  volumeNum?: number;\n' +
      '  openPrice?: number;\n' +
      '  closePrice?: number;\n' +
      '};\n' +
      '\n' +
      "type Tone = 'positive' | 'negative' | 'neutral';\n" +
      '\n' +
      "const TABS: Tab[] = ['Orders', 'Positions', 'Deals', 'Deals & Orders'];\n" +
      "const SORT_OPTIONS: SortBy[] = ['Default', 'Symbol', 'Ticket', 'Type', 'Volume', 'Open Time', 'Close Time', 'Profit'];\n" +
      'const EMPTY_CLOSED_POSITIONS: ClosedPosition[] = [];\n' +
      'const EMPTY_DEALS: Deal[] = [];\n' +
      'const EMPTY_ORDERS: LoginOrder[] = [];\n' +
      'const historyRowKey = (item: { listKey: string }) => item.listKey;\n' +
      '\n' +
      '/**\n' +
      ' * The summary details card is the first thing in the FlatList header, so its top\n' +
      " * edge sits exactly on the list's clip boundary — flush against the pinned balance\n" +
      ' * card. Fractional scroll offsets during a fast fling, and top-edge overscroll\n' +
      ' * (iOS bounce, Android stretch), momentarily pull it clear of that boundary and\n' +
      ' * expose screen background as a hairline seam. The card is pulled up by this much\n' +
      ' * and padded straight back down, so whatever peeks past the clip edge is card\n' +
      ' * background and side borders instead of a gap. Net content height is unchanged.\n' +
      ' */\n' +
      'const SUMMARY_DETAILS_OVERSCROLL_BLEED = 96;\n' +
      '\n' +
      'function safeTimeStr(timestamp?: number | string | Date): string {\n' +
      "  if (timestamp === undefined || timestamp === null || timestamp === '') return '--';\n" +
      "  if (typeof timestamp === 'number' && !Number.isFinite(timestamp)) return '--';\n" +
      '  try {\n' +
      '    return formatBrokerTime(timestamp);\n' +
      '  } catch {\n' +
      "    return '--';\n" +
      '  }\n' +
      '}\n' +
      '\n' +
      'function toFiniteNumber(value: unknown): number | undefined {\n' +
      "  if (typeof value === 'number' && Number.isFinite(value)) {\n" +
      '    return value;\n' +
      '  }\n' +
      '\n' +
      "  if (typeof value === 'string' && value.trim() !== '') {\n" +
      '    const parsed = Number(value);\n' +
      '    if (Number.isFinite(parsed)) {\n' +
      '      return parsed;\n' +
      '    }\n' +
      '  }\n' +
      '\n' +
      '  return undefined;\n' +
      '}\n' +
      '\n' +
      'function pickFiniteNumber(source: Record<string, unknown>, keys: string[]): number | undefined {\n' +
      '  for (const key of keys) {\n' +
      '    const value = toFiniteNumber(source[key]);\n' +
      '    if (value !== undefined) {\n' +
      '      return value;\n' +
      '    }\n' +
      '  }\n' +
      '\n' +
      '  return undefined;\n' +
      '}\n' +
      '\n' +
      'function pickTrimmedString(source: Record<string, unknown>, keys: string[]): string | undefined {\n' +
      '  for (const key of keys) {\n' +
