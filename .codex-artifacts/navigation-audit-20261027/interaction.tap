      "import { useResponsiveLayout } from '../../ui/layout/useResponsiveLayout';\n" +
      "import { shouldScrollTradingSummary } from '../trade/summaryViewport';\n" +
      '\n' +
      "type Tab = 'Positions' | 'Orders' | 'Deals' | 'Deals & Orders';\n" +
      "type SortBy = 'Default' | 'Symbol' | 'Ticket' | 'Type' | 'Volume' | 'Open Time' | 'Close Time' | 'Profit';\n" +
      'type HistoryRow = {\n' +
      '  id: string;\n' +
      '  ticketLabel: string;\n' +
      '  line1: string;\n' +
      '  line2: string;\n' +
      '  time: string;\n' +
      '  openTime?: string;\n' +
