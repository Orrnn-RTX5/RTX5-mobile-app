    type Tone = 'positive' | 'negative' | 'neutral';
    
    const TABS: Tab[] = ['Orders', 'Positions', 'Deals', 'Deals & Orders'];
    const SORT_OPTIONS: SortBy[] = ['Default', 'Symbol', 'Ticket', 'Type', 'Volume', 'Open Time', 'Close Time', 'Profit'];
