    type Tab = 'Positions' | 'Orders' | 'Deals' | 'Deals & Orders';
    type SortBy = 'Default' | 'Symbol' | 'Ticket' | 'Type' | 'Volume' | 'Open Time' | 'Close Time' | 'Profit';
    type HistoryRow = {
